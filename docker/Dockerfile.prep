ARG CUDA_BASE_IMAGE=nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04
FROM ${CUDA_BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ARG FARM_UID=1000
ARG FARM_GID=1000

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        ninja-build \
        python3 \
        python3-dev \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir \
        pip==26.1.2 setuptools==80.10.2 wheel==0.47.0

WORKDIR /opt/farm
COPY requirements/prep-runtime.lock.txt requirements/prep-runtime.lock.txt
RUN python3 -m pip install --no-cache-dir -r requirements/prep-runtime.lock.txt

# Copy only the preparation/preflight source contract.  Models, scenes and
# experiment outputs are runtime mounts and can never leak into this image.
COPY pyproject.toml README.md ./
COPY src ./src
COPY scripts ./scripts
COPY configs ./configs
RUN python3 -m pip install --no-cache-dir --no-deps -e .

# Fail the image build if the resolved direct runtime inventory drifts or the
# GPU preparation modules cannot be imported.  GPU execution itself is a
# runtime smoke because Docker builds must not depend on an NVIDIA device.
RUN python3 scripts/farm_runtime_inventory.py validate \
        --lock requirements/prep-runtime.lock.txt \
    && python3 -c "import cv2, gsplat, matplotlib, numpy, PIL, plyfile, pycolmap, scipy, torch, yaml"

RUN groupadd --gid "${FARM_GID}" farm \
    && useradd --uid "${FARM_UID}" --gid "${FARM_GID}" \
        --create-home --shell /bin/bash farm \
    && mkdir -p /runs /tmp/farm-home \
    && chown -R "${FARM_UID}:${FARM_GID}" /runs /tmp/farm-home

ENV HOME=/tmp/farm-home \
    MPLCONFIGDIR=/tmp/farm-matplotlib \
    XDG_CACHE_HOME=/tmp/farm-cache \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

USER farm
CMD ["python3", "scripts/farm_preflight.py", "--help"]
