ARG MICROMAMBA_IMAGE=mambaorg/micromamba:2.3.3
ARG CUDA_BASE_IMAGE=nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04
FROM ${MICROMAMBA_IMAGE} AS micromamba

FROM ${CUDA_BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ARG FARM_UID=1000
ARG FARM_GID=1000

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        ninja-build \
    && rm -rf /var/lib/apt/lists/*

COPY --from=micromamba /bin/micromamba /usr/local/bin/micromamba
ENV MAMBA_ROOT_PREFIX=/opt/conda \
    PATH=/opt/conda/envs/rest3d/bin:${PATH} \
    TORCH_EXTENSIONS_DIR=/opt/farm-torch-extensions \
    TORCH_CUDA_ARCH_LIST="7.5;8.0;8.6;8.9;9.0"
RUN micromamba create --yes --name rest3d --channel conda-forge \
        python=3.11 pip=26.1.2 \
    && micromamba clean --all --yes \
    && python -m pip install --no-cache-dir \
        setuptools==80.10.2 wheel==0.47.0 \
    && python -c "import sys; assert sys.version_info[:2] == (3, 11); assert sys.executable == '/opt/conda/envs/rest3d/bin/python'"

WORKDIR /opt/farm
COPY requirements/prep-runtime.lock.txt requirements/prep-runtime.lock.txt
RUN python -m pip install --no-cache-dir -r requirements/prep-runtime.lock.txt

# Copy only the preparation/preflight source contract.  Models, scenes and
# experiment outputs are runtime mounts and can never leak into this image.
COPY pyproject.toml README.md ./
COPY src ./src
COPY scripts ./scripts
COPY configs ./configs
RUN python -m pip install --no-cache-dir --no-deps -e .

# Fail the image build if the resolved direct runtime inventory drifts. Build
# the gsplat CUDA extension into the immutable image because production
# containers deliberately cannot execute JIT artifacts from /tmp.
RUN /opt/conda/envs/rest3d/bin/python scripts/farm_runtime_inventory.py validate \
        --lock requirements/prep-runtime.lock.txt \
    && /opt/conda/envs/rest3d/bin/python -c \
       "import cv2, gsplat, matplotlib, numpy, PIL, plyfile, pycolmap, scipy, torch, yaml" \
    && mkdir -p "${TORCH_EXTENSIONS_DIR}" \
    && /opt/conda/envs/rest3d/bin/python -c \
       "from gsplat.cuda._backend import _C; print(_C)" \
    && chmod -R a+rX "${TORCH_EXTENSIONS_DIR}"

RUN groupadd --gid "${FARM_GID}" farm \
    && useradd --uid "${FARM_UID}" --gid "${FARM_GID}" \
        --create-home --shell /bin/bash farm \
    && mkdir -p /runs /tmp/farm-home \
    && chown -R "${FARM_UID}:${FARM_GID}" /runs /tmp/farm-home

ENV HOME=/tmp/farm-home \
    MPLCONFIGDIR=/tmp/farm-matplotlib \
    XDG_CACHE_HOME=/tmp/farm-cache \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

USER farm
CMD ["/opt/conda/envs/rest3d/bin/python", "scripts/farm_preflight.py", "--help"]
